# Base URL of the Laravel API (including the /api/v1 prefix).
# Local dev default shown below. In production, set this to the deployed
# API's HTTPS URL (e.g. https://api.yourdomain.com/api/v1) — Vite inlines
# this value at build time, so it must be set before running `npm run build`.
VITE_API_BASE_URL=http://localhost:8000/api/v1
