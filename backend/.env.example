# Local development defaults. For production: set APP_ENV=production,
# APP_DEBUG=false (never true — it leaks stack traces in API error
# responses), APP_URL to the real HTTPS domain, and generate a fresh
# APP_KEY with `php artisan key:generate` on the production server.
APP_NAME="Premium Gym API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Comma-separated list of origins allowed to call this API (see config/cors.php).
# In production, set this to the deployed frontend's HTTPS origin(s).
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# In production, use LOG_LEVEL=error (or warning) to avoid noisy/verbose logs.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Point these at the production database. Never commit real credentials —
# this file is a template only; the real values live in the server's .env.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gym_system
DB_USERNAME=gym_user
DB_PASSWORD=

# Left empty: this API is bearer-token only, not cookie-based SPA auth.
SANCTUM_STATEFUL_DOMAINS=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production once the app is served over HTTPS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" writes mail to the log instead of sending it — fine for local dev.
# In production, point these at a real SMTP provider (no provider is
# configured or assumed by this app).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Only needed if FILESYSTEM_DISK is switched to "s3" for production uploads.
# Uploads default to the local "public" disk (see config/filesystems.php).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Real SaaS payment gateway (Phase 23). Only Stripe is implemented (see
# config/payment.php / App\Services\Payment) — get these from the Stripe
# Dashboard's API keys and Webhooks pages. Never commit real values here;
# this file is a template only. STRIPE_WEBHOOK_SECRET is the signing
# secret for the specific webhook endpoint you register at
# {APP_URL}/api/v1/webhooks/stripe, not the account's API secret key.
PAYMENT_GATEWAY=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=usd

# WhatsApp / push notification providers (Phase 24). Both are optional —
# App\Services\NotificationChannelDispatcher only queues a job for a
# channel once its access token is present here, so leaving these blank
# simply keeps that channel off (email still works via MAIL_MAILER
# below and needs no credentials for local/log-driver use).
# WhatsApp: Meta's official WhatsApp Business Cloud API only (see
# config/communication.php) — get these from the Meta for Developers
# dashboard for your WhatsApp Business Account.
WHATSAPP_PROVIDER=whatsapp_cloud_api
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0

# Push (Firebase Cloud Messaging HTTP v1 API) — delivers to the Flutter
# Member/Trainer apps' registered device tokens (see DeviceTokenController).
# FCM_ACCESS_TOKEN is a short-lived OAuth2 bearer token minted from a
# Firebase service account (not a static server key) — refreshing it is
# an ops concern outside this app; see config/communication.php.
PUSH_PROVIDER=fcm
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=

# AI assistant/insights (config/ai.php) — any OpenAI-compatible
# /chat/completions endpoint works (OpenAI itself, Azure OpenAI, or a
# self-hosted gateway); leaving OPENAI_API_KEY blank makes the AI
# endpoints return a clean "temporarily unavailable" response (see
# AIProviderException) instead of erroring.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.3

VITE_APP_NAME="${APP_NAME}"
