# Deployment-time variables consumed by deploy/render-templates.sh via
# envsubst — these drive the Nginx/systemd templates in this directory.
# They are infrastructure placement values (domains, paths, socket), not
# application secrets. Copy this file to `deploy/.env.deploy` (gitignored)
# and fill in real values for your server; never commit the real file.
#
# This is separate from backend/.env and frontend/.env — those hold the
# application's own configuration (DB credentials, APP_KEY, etc., see
# backend/.env.example / frontend/.env.example and DEPLOYMENT.md).

# Public domains for the two halves of the app (see "Domain Structure" in
# DEPLOYMENT.md). No default is provided on purpose — do not guess a real
# domain for the user.
FRONTEND_DOMAIN=
API_DOMAIN=

# Absolute paths on the server.
BACKEND_ROOT=/var/www/gym-system/backend
FRONTEND_DIST_ROOT=/var/www/gym-system/frontend-dist

# PHP-FPM socket or host:port this server's pool listens on.
# Common Linux default shown; confirm against your PHP-FPM pool config.
PHP_FPM_SOCK=unix:/run/php/php8.4-fpm.sock

# TLS certificate paths (e.g. from Let's Encrypt / certbot). Separate
# certs per domain, or point both at a single multi-domain cert.
FRONTEND_SSL_CERT=/etc/letsencrypt/live/FRONTEND_DOMAIN/fullchain.pem
FRONTEND_SSL_KEY=/etc/letsencrypt/live/FRONTEND_DOMAIN/privkey.pem
API_SSL_CERT=/etc/letsencrypt/live/API_DOMAIN/fullchain.pem
API_SSL_KEY=/etc/letsencrypt/live/API_DOMAIN/privkey.pem

# Linux user/group PHP-FPM and Nginx run as (used for storage permissions).
WEB_USER=www-data
WEB_GROUP=www-data
